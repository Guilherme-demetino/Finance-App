{
  "expo": {
    "name": "Finance",
    "slug": "my-app",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.guilhermedemetino.myapp",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["REQUEST_INSTALL_PACKAGES"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E1E1E",
          "image": "./assets/images/splash-transparent.png",
          "imageWidth": 1
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#3B82F6"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Usar a câmera para fotografar um recibo e preencher a transação sozinho.",
          "microphonePermission": false
        }
      ],
      ["expo-mlkit-ocr", { "iosEngine": "auto" }],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MonthBalance",
              "label": "Saldo do mês",
              "description": "Receitas e despesas do mês atual.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "UpcomingBills",
              "label": "Próximas contas",
              "description": "As próximas contas e dívidas a vencer.",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ec1426bd-20eb-4494-baa6-8d1489ef84f5"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec1426bd-20eb-4494-baa6-8d1489ef84f5"
      }
    },
    "owner": "guilhermedemetino"
  }
}
